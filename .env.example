# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INQUIRY_ENDPOINT: Google Apps Script Web App URL (free) used by the
# portfolio Inquiry form (via Vercel serverless function) to send submissions
# to a Google Sheet.
# Example:
# INQUIRY_ENDPOINT="https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec"
INQUIRY_ENDPOINT=""

# Firebase lives on the server only (Vercel env / .env.local). Never prefix these with VITE_.
# The browser loads them at runtime from GET /api/firebase-config.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# Admin SDK (server only) — required for /api/book/* and PayMongo webhooks.
# Paste the FULL service-account JSON as ONE LINE (Project settings → Service accounts → Generate new private key).
# Keep \n inside private_key as the two characters backslash+n (do not break the PEM across real newlines).
FIREBASE_SERVICE_ACCOUNT=""
# Or instead of the blob above, set these three:
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# PayMongo — server only. Never prefix with VITE_. Never commit real values.
# Secret key: Dashboard → Developers → API keys (sk_test_… / sk_live_…)
# Webhook secret: Dashboard → Developers → Webhooks → your endpoint signing secret
#   Endpoint URL (prefer): https://www.casinworks.com/api/paymongo-webhook
#   Also works: https://www.casinworks.com/api/paymongo/webhook
#   Events: checkout_session.payment.paid (and payment.paid if you use Links later)
#   Create the webhook in the same mode as the key (test for sk_test_, live for sk_live_)
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Optional override (defaults to 1000). Used only on the server to price checkout.
EXPLORATORY_CONSULTATION_RATE_PHP="1000"
# Canonical site URL for PayMongo success/cancel redirects
APP_URL="https://www.casinworks.com"

# Resend — customer + studio booking emails (server only)
# Verify casinworks.com in Resend, then set RESEND_FROM to an address on that domain.
RESEND_API_KEY=""
RESEND_FROM="CasinWorks <bookings@casinworks.com>"
# Studio copy (BCC) of booking emails
BOOKING_NOTIFY_EMAIL="christianjoshuacasin@gmail.com"

# Google Calendar + Meet (server only) — auto-create Meet when admin confirms a consultation.
# 1. Enable Google Calendar API in Google Cloud Console
# 2. OAuth consent (External; add yourself as test user if app is Testing)
# 3. Create OAuth client (Web) with redirect http://localhost:8787/oauth2callback
# 4. Run: GOOGLE_CLIENT_ID=… GOOGLE_CLIENT_SECRET=… node scripts/google-calendar-oauth.mjs
# 5. Paste the printed refresh token below and on Vercel Production
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# Optional (defaults to primary)
# GOOGLE_CALENDAR_ID="primary"

