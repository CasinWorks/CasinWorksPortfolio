<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Resolved from the APS_ENVIRONMENT build setting: development for Debug and
	  Profile, production for Release. Hardcoding "development" here would ship
	  an App Store build pointed at the APNs sandbox, where no push arrives.
	-->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
